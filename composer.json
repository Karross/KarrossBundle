{
  "name": "karross/karross-bundle",
  "description": "Karross Symfony bundle",
  "type": "symfony-bundle",
  "extra": {
    "symfony": {
      "allow-contrib": true
    }
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Vincent Laurier",
      "email": "contact.karross@gmail.com"
    }
  ],
  "require": {
    "doctrine/persistence": "^4.0",
    "ext-bcmath": "*",
    "ext-intl": "*",
    "php": "^8.5",
    "symfony/config": "^7.3",
    "symfony/dependency-injection": "^7.3",
    "symfony/http-foundation": "^7.3",
    "symfony/http-kernel": "^7.3",
    "symfony/property-access": "^7.3",
    "symfony/routing": "^7.3",
    "symfony/translation-contracts": "^3.6",
    "twig/twig": "^3.21",
    "commerceguys/intl": "^2.0"
  },
  "suggest": {
    "nesbot/carbon": "Required to enable the relative / humanized date formatters (e.g. DateTime\\Carbon\\*)"
  },
  "require-dev": {
    "doctrine/doctrine-bundle": "^2.0",
    "doctrine/orm": "^3.0",
    "symfony/framework-bundle": "^7.3",
    "symfony/twig-bundle": "^7.3",
    "phpunit/phpunit": "^12.0",
    "symfony/translation": "^7.3",
    "playwright-php/playwright-symfony": "^0.10.0",
    "phpstan/phpstan": "^2.2",
    "phpstan/phpstan-symfony": "^2.0",
    "friendsofphp/php-cs-fixer": "^3.95"
  },
  "autoload": {
    "psr-4": {
      "Karross\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TestedApp\\": "tests/Integration/TestedApp",
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "phpstan": "phpstan analyse --no-progress",
    "cs-fix": "php-cs-fixer fix",
    "cs-fix-check": "php-cs-fixer fix --dry-run",
    "all-fix": [
      "@cs-fix"
    ],
    "all-check": [
      "@cs-fix-check",
      "@phpstan",
      "@test"
    ],
    "test": "phpunit"
  }
}
